    {
      "parameters": {
        "jsCode": "const body=$input.first().json.body||$input.first().json; const c=body.config; const types=new Set(['textarea','text','single','multiple','number']); if(!c||!Array.isArray(c.questions)||!c.questions.length) throw new Error('At least one question is required'); const ids=new Set(); c.questions.forEach((q,i)=>{if(!q.id||ids.has(q.id)) q.id='q'+String(i+1).padStart(2,'0')+'-'+Date.now().toString(36); ids.add(q.id); if(!types.has(q.type)||!String(q.title||'').trim()) throw new Error('Invalid question '+(i+1)); if(['single','multiple'].includes(q.type)&&(!Array.isArray(q.options)||q.options.length<2)) throw new Error('Question '+(i+1)+' needs at least two options')}); return [{json:{key:'main',config_json:JSON.stringify(c),updated_at:new Date().toISOString(),config:c}}];"
      },
